.venv/
__pycache__/
*.pyc
*.pyo
*.wav
*.log
dist/
build/
*.egg-info/
models/
tools/
logs/
# Benchmarks, evaluation audio, and reference transcripts. Large binaries, and
# the transcripts are third-party material -- keep them local.
research/
eval/calibration/
*.mp3
*.pdf
debug-asr/
lt-debug*/
# Diagnostic capture. The real defence is that diagnostics default to a per-user
# directory outside any checkout; these two rules only catch a run that was
# pointed back inside one. segment-*.txt holds the transcript and the
# translation in plain text and is the one artifact *.wav above does not cover.
# Do not widen it to *.txt: that would silently untrack requirements.txt.
diagnostics/
segment-*.txt
record-test*.wav
working-input-open-test.wav
app.local*.yaml
app.working-devices.yaml
